{
  "info": {
    "name": "Cryptogamer API",
    "description": "Test suite completa para la API REST de Cryptogamer's e-commerce.\nCubre auth, productos y órdenes con casos positivos, negativos y validación de schema.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "token", "value": "" },
    { "key": "createdProductId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /register - usuario nuevo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response tiene token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('token');",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Response tiene user con email', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.user).to.have.property('email');",
                  "  pm.expect(json.user).to.have.property('name');",
                  "  pm.expect(json.user).to.not.have.property('password');",
                  "});",
                  "pm.test('Tiempo de respuesta < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Test User\",\n  \"email\": \"newman_{{$randomInt}}@cryptogamer.test\",\n  \"password\": \"TestPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "POST /login - credenciales válidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve token JWT', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.token).to.be.a('string');",
                  "  pm.expect(json.token.split('.')).to.have.lengthOf(3);",
                  "  pm.collectionVariables.set('token', json.token);",
                  "});",
                  "pm.test('User no expone password', () => {",
                  "  pm.expect(pm.response.json().user).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "POST /login - contraseña incorrecta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Mensaje de error presente', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('message');",
                  "});",
                  "pm.test('NO devuelve token', () => {",
                  "  pm.expect(pm.response.json()).to.not.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"WrongPassword999\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "POST /login - email inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('NO devuelve token', () => {",
                  "  pm.expect(pm.response.json()).to.not.have.property('token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"noexiste@example.com\",\n  \"password\": \"AnyPassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "GET /me - con token válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve datos del usuario autenticado', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('email');",
                  "  pm.expect(json).to.have.property('name');",
                  "  pm.expect(json).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "GET /me - sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sin token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "GET /products - listado público",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Responde con array de productos', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.data.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('Schema: cada producto tiene id, name, price', () => {",
                  "  const products = pm.response.json().data;",
                  "  products.slice(0, 5).forEach(p => {",
                  "    pm.expect(p).to.have.property('id');",
                  "    pm.expect(p).to.have.property('name');",
                  "    pm.expect(p).to.have.property('price');",
                  "    pm.expect(p.price).to.be.a('number').and.above(0);",
                  "  });",
                  "});",
                  "pm.test('Regla de negocio: originalPrice >= price cuando existe', () => {",
                  "  const products = pm.response.json().data;",
                  "  products.forEach(p => {",
                  "    if (p.originalPrice !== null && p.originalPrice !== undefined) {",
                  "      pm.expect(p.originalPrice).to.be.at.least(p.price);",
                  "    }",
                  "  });",
                  "});",
                  "pm.test('Tiempo de respuesta < 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "// Guardar primer id para el siguiente request",
                  "const first = pm.response.json().data[0];",
                  "if (first) pm.collectionVariables.set('createdProductId', first.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "GET /products?search=xbox - búsqueda",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Responde con paginación', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('data');",
                  "  pm.expect(json).to.have.property('total');",
                  "  pm.expect(json).to.have.property('page');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?search=xbox&pageSize=5",
              "query": [
                { "key": "search", "value": "xbox" },
                { "key": "pageSize", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "GET /products/:id - producto existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Schema completo del producto', () => {",
                  "  const p = pm.response.json();",
                  "  ['id','name','price','description','inStock'].forEach(field => {",
                  "    pm.expect(p).to.have.property(field);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/{{createdProductId}}"
          }
        },
        {
          "name": "GET /products/:id - id inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/id-que-no-existe-99999"
          }
        },
        {
          "name": "POST /products - sin autenticación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sin token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Test Product\", \"price\": 100 }",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "Órdenes",
      "item": [
        {
          "name": "GET /orders/me - mis órdenes autenticado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Responde con array', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "GET /orders/me - sin autenticación",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sin token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/me"
          }
        },
        {
          "name": "GET /orders/track/:orderNumber - orden inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 orden no encontrada', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/track/ORD-NOEXISTE-99999"
          }
        }
      ]
    }
  ]
}
